rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A cart is only reachable by knowing its long random id (the shared link).
    // The carts collection itself can't be listed, so ids can't be enumerated.
    match /carts/{cartId}/items/{itemId} {
      allow get, list: if cartId.size() >= 16;
      allow create: if cartId.size() >= 16
        && request.resource.data.keys().hasOnly(['name', 'checked', 'createdAt', 'category', 'qty', 'note', 'addedBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.checked == false
        && request.resource.data.createdAt is number
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 20
        && (!('qty' in request.resource.data)
            || (request.resource.data.qty is int && request.resource.data.qty >= 1 && request.resource.data.qty <= 99))
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string && request.resource.data.note.size() <= 60))
        && (!('addedBy' in request.resource.data)
            || (request.resource.data.addedBy is string && request.resource.data.addedBy.size() <= 20));
      allow update: if cartId.size() >= 16
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checked', 'category', 'name', 'qty', 'note'])
        && request.resource.data.checked is bool
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && (!('category' in request.resource.data)
            || (request.resource.data.category is string && request.resource.data.category.size() <= 20))
        && (!('qty' in request.resource.data)
            || (request.resource.data.qty is int && request.resource.data.qty >= 1 && request.resource.data.qty <= 99))
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string && request.resource.data.note.size() <= 60));
      allow delete: if cartId.size() >= 16;
    }

    // Receipts: what the family actually paid at a supermarket (store id, total, item count). No edits, only add and delete.
    match /carts/{cartId}/receipts/{receiptId} {
      allow get, list: if cartId.size() >= 16;
      allow create: if cartId.size() >= 16
        && request.resource.data.keys().hasOnly(['storeId', 'total', 'items', 't'])
        && request.resource.data.storeId is string
        && request.resource.data.storeId.size() > 0
        && request.resource.data.storeId.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.total <= 99999
        && request.resource.data.t is number
        && (!('items' in request.resource.data)
            || (request.resource.data.items is int && request.resource.data.items >= 1 && request.resource.data.items <= 1000));
      allow delete: if cartId.size() >= 16;
    }

    // Per-cart settings docs:
    //  prefs   - supermarket walking order + color theme
    //  learned - the family's corrections of product -> section (map of name -> section id)
    //  history - "our products": how often each product was added, pinned or removed (quick-add chips and the products tab)
    //  prices  - shelf prices the family typed in: map of product -> { store id -> unit price }
    //  stores  - which chains the prices tab compares, plus chains the family added
    match /carts/{cartId}/settings/{docId} {
      allow get: if cartId.size() >= 16;
      allow create, update: if cartId.size() >= 16
        && (
          (docId == 'prefs'
            && request.resource.data.keys().hasOnly(['order', 'theme'])
            && (!('order' in request.resource.data)
                || (request.resource.data.order is list && request.resource.data.order.size() <= 30))
            && (!('theme' in request.resource.data)
                || (request.resource.data.theme is string && request.resource.data.theme.size() <= 12)))
          ||
          (docId == 'learned'
            && request.resource.data.keys().hasOnly(['map'])
            && request.resource.data.map is map
            && request.resource.data.map.size() <= 500)
          ||
          (docId == 'history'
            && request.resource.data.keys().hasOnly(['items'])
            && request.resource.data.items is map
            && request.resource.data.items.size() <= 300)
          ||
          (docId == 'prices'
            && request.resource.data.keys().hasOnly(['p'])
            && request.resource.data.p is map
            && request.resource.data.p.size() <= 400)
          ||
          (docId == 'stores'
            && request.resource.data.keys().hasOnly(['sel', 'custom'])
            && (!('sel' in request.resource.data)
                || (request.resource.data.sel is list && request.resource.data.sel.size() <= 20))
            && (!('custom' in request.resource.data)
                || (request.resource.data.custom is list && request.resource.data.custom.size() <= 10)))
        );
    }

    // Invite codes: a short-lived pointer from an 8-character code to a cart id. They exist so a person can
    // join by scanning or typing a code instead of handling the 32-character link.
    //  - get only, never list, so codes can't be enumerated; 32^8 (about 10^12) codes make guessing hopeless
    //  - create only, never update or delete: an existing code can't be overwritten or hijacked (an expired one
    //    just stays taken and the client picks another), and a code stops working by itself at `exp`
    //  - `exp` is a millisecond timestamp at most 7 days ahead
    match /invites/{code} {
      allow get: if code.matches('^[2-9A-HJ-NP-Z]{8}$')
        && resource.data.exp > request.time.toMillis();
      allow create: if code.matches('^[2-9A-HJ-NP-Z]{8}$')
        && request.resource.data.keys().hasOnly(['cartId', 'name', 'exp'])
        && request.resource.data.cartId is string
        && request.resource.data.cartId.matches('^[a-f0-9]{32}$')
        && request.resource.data.exp is number
        && request.resource.data.exp > request.time.toMillis()
        && request.resource.data.exp <= request.time.toMillis() + 604800000
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string && request.resource.data.name.size() <= 30));
    }
  }
}
